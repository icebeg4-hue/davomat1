{
  "name": "maktab-davomat-nazorati",
  "version": "1.0.0",
  "main": "desktop/main.js",
  "scripts": {
    "desktop": "electron desktop/main.js",
    "build:desktop": "electron-builder --win nsis"
  },
  "build": {
    "appId": "uz.school.attendance.desktop",
    "productName": "Maktab Davomat Nazorati",
    "directories": {
      "output": "dist-desktop"
    },
    "files": [
      "desktop/**/*",
      "www/**/*"
    ],
    "win": {
      "icon": "icons/icon-512.png",
      "target": [
        "nsis"
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    }
  },
  "dependencies": {
    "@capacitor/android": "^8.0.0",
    "@capacitor/cli": "^8.0.0",
    "@capacitor/core": "^8.0.0"
  },
  "devDependencies": {
    "electron": "^39.2.4",
    "electron-builder": "^26.0.12"
  }
}
